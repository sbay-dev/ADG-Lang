# ADG-Lang executable function — مقدمةٌ تعريفيةٌ مُشكَّلةٌ مستندةٌ إلى ويكيبيديا
# المصدر: صفحة ويكيبيديا العربية "أبو الأسود الدؤلي"
# الرابط: https://ar.wikipedia.org/wiki/أبو_الأسود_الدؤلي
# الترخيص: Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)
# رابط الترخيص: https://creativecommons.org/licenses/by-sa/4.0/
# هذا النص المكيَّف داخل المثال منشور وفق الترخيص نفسه.
# الغرض: إبراز قدرة ADG-Lang الوظيفية الحديثة، لا نسبة هذا النص إلى أبي الأسود الدؤلي.
adg 0.1.1
program "مقدمةُ-أبي-الأسودِ-ويكيبيديا"

دالةٌ "مقدمةُ_أبي_الأسودِ_من_ويكيبيديا" 
  متنٌ "المصدرُ: ويكيبيديا العربية، صفحةُ أبي الأسودِ الدؤلي، https://ar.wikipedia.org/wiki/أبو_الأسود_الدؤلي، ترخيصُ CC BY-SA 4.0: https://creativecommons.org/licenses/by-sa/4.0/. هذا النصُّ المكيَّفُ منشورٌ وفق الترخيصِ نفسه. هذه صياغةٌ مُشكَّلةٌ مستندةٌ إلى مقدمةِ الصفحةِ لإبرازِ قدرةِ ADG-Lang، وليست نصًّا تراثيًّا منسوبًا إلى أبي الأسود. أبو الأسودِ ظالمُ بنُ عمرو بنِ سفيانَ الدؤليُّ الكنانيُّ البصريُّ، من ساداتِ التابعينَ وأعيانِهم وفقهائِهم وشعرائِهم ومُحدِّثيهم ومن الدُّهاةِ حاضري الجوابِ، وهو عالمٌ نحويٌّ يُنسبُ إليهِ تأسيسُ علمِ النحوِ في العربيةِ وشَكْلُ أحرفِ المصحفِ على الاصطلاحِ القديمِ بوضعِ النُّقَطِ الدالَّةِ على الحركاتِ. وُلِدَ قبلَ الهجرةِ النبويةِ، وآمنَ بالنبيِّ محمدٍ ولم يرهُ، فكانَ من طبقاتِ التابعينَ، وصَحِبَ عليَّ بنَ أبي طالبٍ، ووَلِيَ أعمالًا في البصرةِ، وشَهِدَ معهُ أحداثًا ومعاركَ كبرى. ويُلقَّبُ بملكِ النحوِ؛ إذ تُنسبُ إليهِ أبوابُ الفاعلِ والمفعولِ بهِ والمضافِ وحروفُ النصبِ والرفعِ والجرِّ والجزمِ، وكانتْ مساهماتُهُ أساسًا لما عُرِفَ لاحقًا بالمذهبِ البصريِّ في النحوِ."
  مُخرَجٌ نصٌّ

استدعاءٌ "مقدمةُ_أبي_الأسودِ_من_ويكيبيديا"
