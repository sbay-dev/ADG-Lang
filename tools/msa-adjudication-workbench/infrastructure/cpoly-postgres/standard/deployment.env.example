# Non-secret deployment settings only. Copy to a protected path outside source control.
CPOLY_POSTGRES_BIND_ADDRESS=127.0.0.1
CPOLY_POSTGRES_PORT=5432
CPOLY_POSTGRES_MAX_CONNECTIONS=80
CPOLY_POSTGRES_MEMORY_LIMIT=4g
CPOLY_POSTGRES_CPU_LIMIT=2.0
CPOLY_POSTGRES_DATA_VOLUME=cpoly-adg-postgres-data
CPOLY_REQUIRE_CLIENT_CERT=false

# The certificate SAN must include this internal Compose DNS name and the public
# Hyperdrive origin DNS name.
CPOLY_POSTGRES_INTERNAL_TLS_NAME=postgres

# Hook owned by the portal's PostgreSQL adapter/migration work.
ADG_POSTGRES_MIGRATIONS_DIR=../migrations/postgresql

# WAL-G/S3-compatible backup settings. R2 is optional and not assumed active.
WALG_S3_PREFIX=s3://REPLACE_BUCKET/adg-msa-adjudication/postgres
AWS_ENDPOINT=https://REPLACE_S3_ENDPOINT
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
WALG_S3_SSE=AES256
WALG_RETENTION_FULL=14
